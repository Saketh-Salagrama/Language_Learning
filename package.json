{
  "name": "bolo",
  "version": "1.0.0",
  "description": "Bolo language learning app",
  "main": "electron-main.js",
  "scripts": {
    "www": "node scripts/www.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.bolo.learn",
    "productName": "Bolo",
    "files": ["electron-main.js", "index.html", "sw.js", "manifest.webmanifest", "icon-*.png", "vendor/**", "fonts/**"],
    "win": { "icon": "icon-512.png", "target": "portable" }
  }
}
